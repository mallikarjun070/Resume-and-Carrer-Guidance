# =============================================
# CareerCraft - Environment Variables Template
# =============================================
# Copy this file, rename it to .env, and fill in your actual values.
# NEVER commit the actual .env file to GitHub.

PORT=5001

# MongoDB Atlas Connection String
# Get from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Google Gemini AI API Key
# Get from: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (make this a long, random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5174

# Gmail Credentials (for sending emails)
# Use Gmail App Password (NOT your regular Gmail password)
# Enable at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
